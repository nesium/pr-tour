{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewer's tour",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "branch", "base", "base_sha", "head_sha", "intent", "reading_order", "steps", "concerns"],
  "properties": {
    "version": { "const": 1 },
    "branch": { "type": "string", "description": "The branch under review." },
    "base": { "type": "string", "description": "The branch it merges into, e.g. develop." },
    "base_sha": { "type": "string", "description": "Full SHA of git merge-base <base> <branch>." },
    "head_sha": { "type": "string", "description": "Full SHA of the reviewed commit. Line numbers refer to this commit." },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string" },
        "session": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "intent": { "type": "string", "description": "What the change does and why, 2-3 sentences." },
    "reading_order": {
      "type": "array",
      "description": "Files in the order to read them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "why"],
        "properties": {
          "file": { "type": "string" },
          "why": { "type": "string", "description": "Why this file comes at this point." }
        }
      }
    },
    "steps": {
      "type": "array",
      "description": "Meaningful changes in reading order. Mechanical changes are grouped into one step.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tag", "title", "why", "anchors"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "tag": { "enum": ["read_closely", "skim"] },
          "hotspot": { "type": "boolean", "description": "One of the 2-3 places to read most closely." },
          "title": { "type": "string", "description": "Short label, under 60 characters." },
          "why": { "type": "string", "description": "Why this change exists. Markdown allowed." },
          "check": { "type": "string", "description": "For hotspots: what exactly to verify." },
          "anchors": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/anchor" }
          }
        }
      }
    },
    "concerns": {
      "type": "array",
      "description": "Uncertain, risky or unverified points. Short; not a bug hunt.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string" },
          "anchor": { "$ref": "#/$defs/anchor" }
        }
      }
    },
    "skipped": {
      "type": "array",
      "description": "What the tour leaves out on purpose. Every change is in a step, a concern, or here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "why"],
        "properties": {
          "file": { "type": "string", "description": "A repo-relative path, or a glob: * within a folder, ** across folders, ? one character." },
          "why": { "type": "string", "description": "Why it needs no review, e.g. generated, lockfile, binary asset." }
        }
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "start", "end"],
      "properties": {
        "file": { "type": "string", "description": "Repo-relative path." },
        "side": { "enum": ["new", "old"], "default": "new", "description": "old: line numbers in base_sha, for removed code." },
        "start": { "type": "integer", "minimum": 1 },
        "end": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
